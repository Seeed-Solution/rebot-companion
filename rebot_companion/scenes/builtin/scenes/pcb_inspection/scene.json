{
  "id": "pcb_inspection",
  "name": "PCB AOI & Sorting Cell",
  "version": "1.0.0",
  "description": "4-stage AOI continuity test fixture and Pass/NG sorting cell with dual bins and divider keepouts.",
  "world_xml": "world.xml",
  "robots": ["b601dm"],
  "default_tool": "suction",
  "recommended_tools": ["suction", "screwdriver", "default"],
  "objects": [
    {
      "name": "pcb",
      "body": "pcb",
      "geom": "pcb",
      "class_name": "pcb",
      "default_pos": [0.23, -0.14, 0.011],
      "jitter_xy": 0.015
    }
  ],
  "zones": {
    "infeed_tray": {
      "center": [0.23, -0.14, 0.018],
      "half_extents": [0.055, 0.055, 0.025]
    },
    "test_fixture": {
      "center": [0.27, 0.01, 0.024],
      "half_extents": [0.045, 0.040, 0.025]
    },
    "outfeed_bin": {
      "center": [0.26, 0.14, 0.022],
      "half_extents": [0.050, 0.050, 0.025]
    },
    "ng_bin": {
      "center": [0.16, 0.14, 0.022],
      "half_extents": [0.045, 0.050, 0.025]
    }
  },
  "io": [
    {
      "name": "fixture_test_pass",
      "kind": "bool",
      "direction": "input",
      "default": false,
      "description": "Electrical test fixture result signal indicating PCB board passed continuity check"
    },
    {
      "name": "board_ng",
      "kind": "bool",
      "direction": "input",
      "default": false,
      "description": "Defect detection flag routing board to NG bin"
    }
  ],
  "task_stages": [
    {
      "id": "pcb_picked",
      "type": "object_grasped",
      "object": "pcb",
      "min_z": 0.045,
      "latch": true
    },
    {
      "id": "fixture_tested",
      "type": "object_in_zone",
      "object": "pcb",
      "zone": "test_fixture",
      "dwell_s": 0.8,
      "indicator_geom": "fixture_led",
      "indicator_rgba": [0.15, 0.90, 0.35, 1.0],
      "requires": ["pcb_picked"],
      "latch": true
    },
    {
      "id": "pcb_sorted",
      "type": "object_in_zone",
      "object": "pcb",
      "zone": "outfeed_bin",
      "requires": ["fixture_tested"],
      "latch": true
    }
  ],
  "poses": {
    "scan": {
      "xyz": [0.23, -0.14, 0.20],
      "rpy": [0.0, 1.5707963, 0.0],
      "note": "Overhead inspection scan pose looking at infeed tray"
    },
    "infeed_approach": {
      "xyz": [0.23, -0.14, 0.08],
      "rpy": [0.0, 1.5707963, 0.0]
    },
    "infeed_pick": {
      "xyz": [0.23, -0.14, 0.015],
      "rpy": [0.0, 1.5707963, 0.0]
    },
    "divider_clear": {
      "xyz": [0.25, -0.065, 0.10],
      "rpy": [0.0, 1.5707963, 0.0],
      "note": "Clearance height above divider wall"
    },
    "fixture_approach": {
      "xyz": [0.27, 0.01, 0.08],
      "rpy": [0.0, 1.5707963, 0.0]
    },
    "fixture_place": {
      "xyz": [0.27, 0.01, 0.022],
      "rpy": [0.0, 1.5707963, 0.0]
    },
    "outfeed_approach": {
      "xyz": [0.26, 0.14, 0.08],
      "rpy": [0.0, 1.5707963, 0.0]
    },
    "outfeed_place": {
      "xyz": [0.26, 0.14, 0.022],
      "rpy": [0.0, 1.5707963, 0.0]
    },
    "ng_place": {
      "xyz": [0.16, 0.14, 0.022],
      "rpy": [0.0, 1.5707963, 0.0]
    }
  },
  "keepout_boxes": [
    {
      "name": "divider_wall",
      "min": [0.175, -0.070, 0.0],
      "max": [0.325, -0.060, 0.055]
    },
    {
      "name": "bin_divider",
      "min": [0.198, 0.090, 0.0],
      "max": [0.212, 0.190, 0.042]
    }
  ],
  "training": {
    "recommended_approach": "hybrid_rules_and_vision_or_il",
    "rules_stages": ["fixture_tested", "pcb_sorted"],
    "vision_stages": ["pcb_picked"],
    "il_notes": "Train pick, test, and sort sequence with suction or parallel gripper."
  },
  "assets": []
}

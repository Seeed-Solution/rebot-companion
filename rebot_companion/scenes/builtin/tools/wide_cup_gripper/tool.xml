<mujoco model="wide_cup_gripper_tool">
  <worldbody>
    <!-- Wide palm bar & rear actuator housing mounted behind end_link TCP (local -x) -->
    <geom name="cup_palm" type="box" pos="-0.090 0 0" size="0.016 0.098 0.032"
          rgba="0.22 0.24 0.28 1"/>
    <geom name="cup_motor_housing" type="box" pos="-0.130 0 0" size="0.023 0.030 0.030"
          rgba="0.16 0.18 0.22 1"/>

    <body name="cup_jaw_left" pos="0 0 0">
      <joint name="cup_jaw_left" type="slide" axis="0 1 0" range="-0.001 0.052" damping="5"/>
      <inertial pos="-0.035 0.015 0" mass="0.035" diaginertia="1e-5 1e-5 1e-5"/>
      <geom name="cup_carriage_left" type="box" pos="-0.065 0.016 0" size="0.015 0.010 0.022"
            rgba="0.30 0.32 0.36 1"/>
      <geom name="cup_pad_left" type="box" pos="-0.016 0.0075 0" size="0.016 0.0075 0.024"
            rgba="0.16 0.45 0.58 1" priority="2" friction="2.4 0.04 0.004" condim="4"/>
    </body>

    <body name="cup_jaw_right" pos="0 0 0">
      <joint name="cup_jaw_right" type="slide" axis="0 -1 0" range="-0.001 0.052" damping="5"/>
      <inertial pos="-0.035 -0.015 0" mass="0.035" diaginertia="1e-5 1e-5 1e-5"/>
      <geom name="cup_carriage_right" type="box" pos="-0.065 -0.016 0" size="0.015 0.010 0.022"
            rgba="0.30 0.32 0.36 1"/>
      <geom name="cup_pad_right" type="box" pos="-0.016 -0.0075 0" size="0.016 0.0075 0.024"
            rgba="0.16 0.45 0.58 1" priority="2" friction="2.4 0.04 0.004" condim="4"/>
    </body>
  </worldbody>

  <equality>
    <joint name="cup_jaw_coupling" joint1="cup_jaw_left" joint2="cup_jaw_right"
           polycoef="0 1 0 0 0" solimp="0.99 0.999 0.0001" solref="0.002 1"/>
  </equality>

  <actuator>
    <position name="m7_cup" joint="cup_jaw_left" kp="100" dampratio="1" forcerange="-20 20"/>
  </actuator>
</mujoco>
